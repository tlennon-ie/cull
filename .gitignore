# ─── Environment & Secrets ────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.template
!.env.example

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# ─── Virtualenvs ───────────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── Tooling caches ────────────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytest_cache/
.cache/
*.cache
.coverage
htmlcov/

# ─── Logs ──────────────────────────────────────────────────────────────────
logs/
logs_test/
*.log

# ─── Pipeline local state (large / machine-specific) ───────────────────────
queue/
sorted/
data/
seen_*.json
dashboard_state.json
# Worker mid-flight lock files - if left behind by a crash they're recovered
# by the supervisor's stale-processing sweep, but never committed.
*.processing

# ─── Temp / archive ────────────────────────────────────────────────────────
archive/
temp/
tmp/
*.tmp

# ─── IDE / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Credentials safety net ────────────────────────────────────────────────
# Catch-all to keep ad-hoc secret dumps out of the repo. The pipeline_code/
# credentials.py module is the only committed file matching *credentials*; it
# contains no secrets (reads os.environ at call time) and is explicitly
# whitelisted below.
*credentials*
*secret*
*token*
*password*
!credentials.template
!*credentials*.example
!pipeline_code/credentials.py

# ─── Exception: allow template and example files ──────────────────────────
!.env.template
!.env.example

# Internal design docs — working contracts, not shipped
docs/*-design.md

# Local planning scratch — never commit
/plan.md
