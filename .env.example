# Copy to .env and fill in the blanks. Never commit the real .env.

# ─── Vision providers ─────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEYS=key1,key2,key3
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

LMSTUDIO_PRIMARY_URL=http://127.0.0.1:1234
LMSTUDIO_PRIMARY_MODEL=qwen3.5-9b-uncensored-hauhaucs-aggressive
LMSTUDIO_PRIMARY_TIMEOUT=120

LMSTUDIO_SECONDARY_URL=http://192.168.1.100:1234
LMSTUDIO_SECONDARY_MODEL=qwen3-vl-8b-thinking-abliterated
LMSTUDIO_SECONDARY_TIMEOUT=60

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── Scraper sources ──────────────────────────────────────────────────────
CIVITAI_API_KEY=your_civitai_api_key_here
CIVITAI_SEARCH_URL=https://search-new.civitai.com/multi-search

# X/Twitter — cookie-based scraping, no OAuth needed
TWITTER_COOKIES=auth_token=...; ct0=...; twid=...

# Discord bot token + channels JSON
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNELS_JSON={"channels":[{"id":"...","name":"...","guild":"...","kind":"png_embed"}]}

# Reddit — scraper uses public JSON, these are optional
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ImagePipelineBot/1.0

# ─── Pipeline configuration ───────────────────────────────────────────────
PIPELINE_TOPIC=Realistic Female Influencer
PIPELINE_SLUG=realistic_female_influencer

# Topic-aware scraper filters (all optional; see topic_filter.py).
TOPIC_KEYWORDS_EXTRA=
TOPIC_BANNED_KEYWORDS=
TOPIC_GENERATION_HINTS=
REDDIT_SUBREDDITS=StableDiffusion,aiArt,sdforall,FluxAI,MidjourneyAI
MIN_PROMPT_LENGTH=40

PIPELINE_BASE_DIR=I:\AI\openclaw\workspace\prompt-library
PIPELINE_QUEUE=I:\AI\openclaw\workspace\prompt-library\queue
PIPELINE_SORTED=I:\AI\openclaw\workspace\prompt-library\sorted

WORKSPACE_ROOT=I:\AI\openclaw\workspace\claude
PIPELINE_CODE_DIR=I:\AI\openclaw\workspace\claude\pipeline_code

PIPELINE_VISION_WORKER=lm-autodetect
PIPELINE_VISION_WORKERS=lm-autodetect

# ─── ZforFree feeders ─────────────────────────────────────────────────────
ZFORFREE_LOCAL_SRC=
ZFORFREE_LOCAL_ENABLED=false
ZFORFREE_WEB_ENABLED=false

# Generic local-folder importer - mirror any folder on disk into the queue.
LOCAL_IMPORT_DIR=
LOCAL_IMPORT_NAME=local
LOCAL_IMPORT_ENABLED=false

# ─── Civitai dual-domain ──────────────────────────────────────────────────
CIVITAI_DOMAINS=civitai.com,civitai.red
CIVITAI_TRPC_BASE=https://civitai.com/api/trpc
CIVITAI_CDN_BASE=https://image.civitai.com/xG1nkqKTMzGDvpLrqFT7WA

# ─── Dashboard runtime state ──────────────────────────────────────────────
DASHBOARD_THROTTLE_PERCENT=100
DASHBOARD_PAUSED=false
SCRAPER_DISABLED=

# ─── Parallel processing ──────────────────────────────────────────────────
SCRAPER_THREADS=5
VISION_WORKER_THREADS=4
BATCH_SIZE=10
SCRAPER_TIMEOUT_SECONDS=300
VISION_WORKER_TIMEOUT_SECONDS=120
RETRY_ATTEMPTS=3

# ─── Dashboard + logging ──────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production
LOG_LEVEL=INFO
LOG_DIR=I:\AI\openclaw\workspace\prompt-library\logs_test

# ─── Housekeeping ─────────────────────────────────────────────────────────
TOKEN_ROTATION_DAYS=90
BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30
QUEUE_CLEANUP_DAYS=14
SORTED_RETENTION_DAYS=180
