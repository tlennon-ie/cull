# Copy to .env and fill in the blanks. Never commit the real .env.
#
# ════════════════════════════════════════════════════════════════════════════
# cull now uses a JOBS MODEL. A "job" is a named curation target whose config
# lives at data/jobs/<slug>.json (queue order + active pointer in
# data/jobs/_index.json). You edit jobs in the dashboard's job editor, NOT here.
#
# This file holds GLOBAL settings only: credentials, model endpoints, vision
# worker selection, base paths, throttle/reconcile/blur. Those stay authoritative
# and apply to every job.
#
# Per-job config (topic, scraper targets, categories, scoring, captioning,
# local folders) is now managed in the dashboard. cull uses a PRESET LIBRARY
# (data/jobs/_presets.json): each job references a named preset and stores only
# sparse overrides — the effective config is preset ⊕ overrides. The PER-JOB
# keys further down are kept here only as LEGACY SEEDS: on first upgrade,
# tools/migrate_to_jobs.py (and the dashboard/supervisor on first run) read them
# once to build the auto-created "default" job/preset. After that, the ACTIVE
# JOB'S CONFIG OVERRIDES THEM at runtime (job_config.resolve_env is merged over
# this .env when the supervisor spawns children). Editing them here has no effect
# once a job is active.
#
# Upgrading from a pre-jobs cull? Run:  python tools/migrate_to_jobs.py
# It is safe and idempotent and never moves your existing data/queue or
# data/sorted folders.
# ════════════════════════════════════════════════════════════════════════════


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ GLOBAL — authoritative, applies to every job                             ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ─── Vision providers (endpoints + credentials are GLOBAL) ─────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEYS=key1,key2,key3
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

LMSTUDIO_PRIMARY_URL=http://127.0.0.1:1234
LMSTUDIO_PRIMARY_MODEL=qwen3.5-9b-uncensored-hauhaucs-aggressive
LMSTUDIO_PRIMARY_TIMEOUT=120

# Optional second LM Studio instance for parallel vision throughput.
# Leave URL blank to disable; otherwise point at e.g. http://192.168.1.100:1234.
LMSTUDIO_SECONDARY_URL=
LMSTUDIO_SECONDARY_MODEL=qwen3-vl-8b-thinking-abliterated
LMSTUDIO_SECONDARY_TIMEOUT=60

# ─── Other local inference backends (alternatives to LM Studio) ───────────
# Use the `balanced-openai-compat` worker for any local server that exposes
# OpenAI's /v1/chat/completions with image_url + JSON-schema response_format.
# Confirmed compatible: llama.cpp (`llama-server`), vLLM, koboldcpp, LocalAI,
# text-generation-webui's OpenAI extension. Run `curl <url>/v1/models` to
# discover the model identifier the server expects.
#
# Example for llama.cpp's llama-server:
#   OPENAI_COMPAT_URL=http://127.0.0.1:8080
#   OPENAI_COMPAT_MODEL=Qwen2.5-VL-7B-Instruct-Q5_K_M.gguf
OPENAI_COMPAT_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_TIMEOUT=600

# Use the `balanced-ollama` worker for Ollama. Hits /api/chat with native
# format=<schema> instead of the OpenAI compat layer (which has weaker JSON-
# schema enforcement). Pull a vision-capable model first:
#   `ollama pull llama3.2-vision`  or  `ollama pull minicpm-v`
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=600

# Gemini support was removed - the abandoned vendor SDK kept failing on
# NSFW filter, and the maintainer's GCP project was suspended. Re-add when
# someone ports the worker to the google.genai SDK.

# Vision worker selection (which provider the supervisor spawns). GLOBAL.
PIPELINE_VISION_WORKER=lm-autodetect
PIPELINE_VISION_WORKERS=lm-autodetect

# ─── Scraper credentials (GLOBAL — targets/toggles are per-job, see below) ─
CIVITAI_API_KEY=your_civitai_api_key_here
# Optional: separate key for civitai.red (its auth backend is independent).
CIVITAI_API_RED_KEY=
CIVITAI_SEARCH_URL=https://search-new.civitai.com/multi-search
CIVITAI_TRPC_BASE=https://civitai.com/api/trpc
# CDN base - override only if Civitai changes their CDN routing.
CIVITAI_CDN_BASE=

# X/Twitter — cookie-based scraping, no OAuth needed
TWITTER_COOKIES=auth_token=...; ct0=...; twid=...

# Discord bot token + auth mode (the channels JSON is per-job, see below).
DISCORD_BOT_TOKEN=your_discord_bot_token_or_user_token_here
# bot | user | auto - see scraper_discord.py for the difference.
DISCORD_AUTH_MODE=auto

# Reddit — scraper uses public JSON, these are optional
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=cull/0.1

# ─── Storage layout (GLOBAL) ──────────────────────────────────────────────
# Leave these blank to use repo-local defaults
# (./data/queue, ./data/sorted, ./data/logs, ./data/jobs). Override with
# absolute paths only if you need queue/sorted on a different disk to the repo.
PIPELINE_BASE_DIR=
PIPELINE_QUEUE=
PIPELINE_SORTED=

# Repo paths - usually auto-detected. Only set if running from outside the repo.
WORKSPACE_ROOT=
PIPELINE_CODE_DIR=

# ─── Supervisor + dashboard runtime (GLOBAL) ──────────────────────────────
# Supervisor reconcile interval (seconds). Lower = snappier live reload.
PIPELINE_RECONCILE_SECONDS=2
# Dashboard: blur NSFW thumbnails until you click the per-image eye icon.
BLUR_NSFW_THUMBS=true
DASHBOARD_THROTTLE_PERCENT=100
DASHBOARD_PAUSED=false

# ─── Parallel processing (GLOBAL) ─────────────────────────────────────────
SCRAPER_THREADS=5
VISION_WORKER_THREADS=4
BATCH_SIZE=10
SCRAPER_TIMEOUT_SECONDS=300
VISION_WORKER_TIMEOUT_SECONDS=120
RETRY_ATTEMPTS=3

# ─── Dashboard + logging (GLOBAL) ─────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production
LOG_LEVEL=INFO
# Leave LOG_DIR blank to write logs under <PIPELINE_BASE_DIR>/logs_test
LOG_DIR=

# ─── Housekeeping (GLOBAL) ────────────────────────────────────────────────
TOKEN_ROTATION_DAYS=90
BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30
QUEUE_CLEANUP_DAYS=14
SORTED_RETENTION_DAYS=180


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ LEGACY / per-job defaults — managed per-job (presets + overrides) now      ║
# ║                                                                            ║
# ║ The keys below moved INTO the preset library + per-job overrides           ║
# ║ (data/jobs/_presets.json + data/jobs/<slug>.json). They remain here only   ║
# ║ to SEED the auto-created "default" job/preset on first upgrade. Once any    ║
# ║ job is active, its effective config overrides everything in this section   ║
# ║ (the supervisor merges job_config.resolve_env over this .env at spawn).    ║
# ║ Edit these in the dashboard's job editor / preset editor, not here.        ║
# ║                                                                            ║
# ║ NOTE: local folders are now a per-job LIST (scrapers.local_imports, each   ║
# ║ {name, dir, enabled, migrate_from}) projected as LOCAL_IMPORTS_JSON — the  ║
# ║ old single LOCAL_IMPORT_* and ZFORFREE_* keys are gone (ZForFree-local is  ║
# ║ folded into local folders). Add folders in the dashboard, not here.        ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ─── Job identity seed (adopted as the "default" job's slug on migration) ──
# PIPELINE_SLUG becomes the migrated job's slug, so it inherits any existing
# data/queue/<slug> + data/sorted/<slug> WITHOUT moving files.
PIPELINE_TOPIC=Realistic Female Influencer
PIPELINE_SLUG=realistic_female_influencer

# ─── Per-job: topic-aware scraper filters (see topic_filter.py) ───────────
TOPIC_KEYWORDS_EXTRA=
TOPIC_BANNED_KEYWORDS=
TOPIC_GENERATION_HINTS=
MIN_PROMPT_LENGTH=40
# Set to false to let scrapers ingest images that don't have a prompt /
# caption attached. Combine with AUTO_CAPTION_ENABLED below to fill the
# blanks in via the vision worker. Default true preserves the
# MIN_PROMPT_LENGTH behaviour the existing scrapers rely on.
REQUIRE_PROMPT=true

# ─── Per-job: scraper enable/disable + targets ────────────────────────────
# Per-job toggles live in the job's scrapers.enabled map; SCRAPER_DISABLED is
# the legacy projection (comma-sep scraper NAMES that start disabled).
SCRAPER_DISABLED=
# Reddit subreddits (comma-sep) — per-job target list.
REDDIT_SUBREDDITS=StableDiffusion,aiArt,midjourney,sdforall,FluxAI,civitai,nightcafe,dalle2,AIPrompts,PromptDesign,AIGeneratedArt,artificial,aiArtwork,AIPorn,aigirls
# X.com accounts (comma-sep, no @). Empty = search-only. Delete variable to use defaults.
X_ACCOUNTS=
# Discord channels to scrape (per-job). JSON string.
DISCORD_CHANNELS_JSON={"channels":[{"id":"...","name":"...","guild":"...","kind":"png_embed"}]}
# Civitai domains to crawl (per-job).
CIVITAI_DOMAINS=civitai.com,civitai.red

# ─── Per-job: gallery-dl scraper (340+ sites: Pixiv, DeviantArt, booru, ───
# ArtStation, Tumblr, Newgrounds, FurAffinity, e621, X, Reddit, Imgur, ...) ─
GALLERY_DL_ENABLED=false
# One URL per line OR comma-separated. # comments are tolerated.
# Example: https://www.pixiv.net/users/12345
GALLERY_DL_URLS=
GALLERY_DL_LIMIT_PER_URL=50
# Netscape cookies.txt - required for Pixiv / X / private galleries.
GALLERY_DL_COOKIES_FILE=
# Optional: extra gallery-dl JSON config file loaded on top of cull defaults.
GALLERY_DL_CONFIG_PATH=

# Local folders (and the former ZForFree-local source) are configured per-job
# in the dashboard as a LIST under scrapers.local_imports — there are no env
# keys to set here. On first upgrade, legacy LOCAL_IMPORT_* / ZFORFREE_LOCAL_SRC
# values still in your .env are read once and folded into that list.

# ─── Per-job: vision quality thresholds (0-100; 0 disables the gate) ──────
VISION_OVR_MIN_SCORE=0
VISION_REL_MIN_SCORE=0
VISION_SCORE_NOTES=

# ─── Per-job: auto-captioning ─────────────────────────────────────────────
# When enabled the vision worker writes <image>.txt next to <image>.vision.json
# using a single combined LLM call.
AUTO_CAPTION_ENABLED=false
# sd_prompt | booru_tags | natural_language
AUTO_CAPTION_STYLE=sd_prompt
# When true, regenerate the .txt for every image even if the source already
# supplied a prompt. When false, only fills .txt when the source had none.
AUTO_CAPTION_OVERWRITE=false
